# Postgres connection string (Neon via the Vercel Marketplace sets this for you;
# locally: `vercel env pull .env.local`)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Encrypts the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# One-time passkey enrollment at /setup?token=<SETUP_TOKEN> (16+ chars).
# Closes itself after the first passkey is saved; set a NEW value to re-open
# it if you ever lose all your passkeys. Generate with: openssl rand -hex 24
SETUP_TOKEN=

# Production only: pin passkeys to the final domain (they can't move domains later).
# WEBAUTHN_RP_ID=open-bible.example.com
# WEBAUTHN_ORIGIN=https://open-bible.example.com

# dra (Douay-Rheims placeholder, default) | nabre (once licensed and seeded)
# BIBLE_TRANSLATION=dra
